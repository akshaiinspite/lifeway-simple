# Apache / LiteSpeed / cPanel 1-Year Immutable Cache Configuration
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # 1-Year Immutable Caching for Static Bundles and Assets
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must revalidate for immediate updates
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ─── URL handling (Apache / LiteSpeed on Linux hosting) ───
Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301: old service URLs -> SEO slugs (keeps Google rankings & backlinks)
  RewriteRule ^services/(physiotherapy-centre-perinthalmanna|physiotherapy)/?$ /physiotherapy-centre-perinthalmanna [R=301,L,NC]
  RewriteRule ^services/(occupational-therapy-in-perinthalmanna|occupational-therapy)/?$ /occupational-therapy-in-perinthalmanna [R=301,L,NC]
  RewriteRule ^services/(speech-therapy-perinthalmanna|speech-therapy)/?$ /speech-therapy-perinthalmanna [R=301,L,NC]
  RewriteRule ^services/(special-education-classroom|special-education)/?$ /special-education-classroom [R=301,L,NC]
  RewriteRule ^services/(clinical-psychology-centre-malappuram|clinical-psychology)/?$ /clinical-psychology-centre-malappuram [R=301,L,NC]
  RewriteRule ^about-us/directors-message/?$ /best-rehabilitation-centre-malappuram/directors-message [R=301,L,NC]
  RewriteRule ^about-us/?$ /best-rehabilitation-centre-malappuram [R=301,L,NC]

  # SPA fallback: serve real files/folders directly, everything else -> index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
